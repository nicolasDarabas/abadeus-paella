<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Topo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_topo"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/margem"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tituloRetirada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retirada"
                android:textAppearance="@style/Texto.Titulo" />

            <TextView
                android:id="@+id/subtituloRetirada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="Leia o QR Code do comprador e entregue a paella."
                android:textAppearance="@style/Texto.Corpo"
                android:textColor="@color/terracota_escuro" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Modo contingência (sem internet)"
                android:textAppearance="@style/Texto.Corpo"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Leitor -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margem_pequena">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_selo">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_qr"
                        app:tint="@color/terracota" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoLerQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="LER QR CODE"
                    app:icon="@drawable/ic_qr" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ou digite o número do pedido / código"
                    android:textAppearance="@style/Texto.Rotulo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="PAE-XXXXXX">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapCharacters"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botaoValidarManual"
                        style="@style/Widget.Abadeus.Botao.Oliva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Validar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Resultado da ultima leitura -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margem_pequena"
            android:layout_marginEnd="@dimen/margem_pequena"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/resIcone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Texto.Subtitulo" />

                    <TextView
                        android:id="@+id/resPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Texto.Corpo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resItens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/Texto.Corpo" />

                    <TextView
                        android:id="@+id/resDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/Texto.Rotulo" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Banco local / contingencia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margem_pequena"
            app:cardBackgroundColor="@color/oliva_claro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banco local (sem internet)"
                    android:textAppearance="@style/Texto.Subtitulo" />

                <TextView
                    android:id="@+id/textoLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/Texto.Corpo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Antes do evento, baixe a lista de pedidos pagos. Se a internet cair, ative o modo contingência e continue validando. Depois, toque em Sincronizar."
                    android:textAppearance="@style/Texto.Rotulo"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botaoBaixar"
                        style="@style/Widget.Abadeus.Botao.Oliva"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Baixar lista"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_download" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botaoSincronizar"
                        style="@style/Widget.Abadeus.Botao.Oliva"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Sincronizar"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_sync" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
