<?xml version="1.0" encoding="utf-8"?>
<!-- Usado em "Meus pedidos" (comprador) e "Pedidos" (administrador) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topo"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tituloLista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.Titulo" />

        <TextView
            android:id="@+id/subtituloLista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:textAppearance="@style/Texto.Corpo"
            android:textColor="@color/terracota_escuro" />

        <HorizontalScrollView
            android:id="@+id/rolagemFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filtros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/listaVazia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textAppearance="@style/Texto.Corpo"
        android:textColor="@color/cinza"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/margem_pequena" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
