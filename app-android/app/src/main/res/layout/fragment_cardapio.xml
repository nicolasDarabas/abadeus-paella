<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Topo: saudacao + evento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topo"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/margem"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/logo_abadeus" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoOla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá!"
                    android:textAppearance="@style/Texto.Titulo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="Escolha sua paella e ajude a ABADEUS."
                    android:textAppearance="@style/Texto.Corpo"
                    android:textColor="@color/terracota_escuro" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textoEvento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/carregando"
                        android:textAppearance="@style/Texto.Subtitulo" />

                    <TextView
                        android:id="@+id/statusEvento"
                        style="@style/Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textoData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/Texto.Corpo"
                    app:drawableStartCompat="@drawable/ic_calendario"
                    app:drawableTint="@color/terracota" />

                <TextView
                    android:id="@+id/textoLocal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/Texto.Corpo"
                    app:drawableStartCompat="@drawable/ic_local"
                    app:drawableTint="@color/terracota" />

                <TextView
                    android:id="@+id/textoRegras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Regras da retirada e contato ›"
                    android:textAppearance="@style/Texto.Rotulo"
                    android:textColor="@color/oliva"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
        android:id="@+id/avisoOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terracota_claro"
        android:padding="12dp"
        android:text="@string/sem_conexao"
        android:textAppearance="@style/Texto.Rotulo"
        android:textColor="@color/terracota_escuro"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margem_pequena"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/margem_pequena"
            android:paddingBottom="12dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barra do carrinho -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/barraCarrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margem_pequena"
        android:visibility="gone"
        app:cardBackgroundColor="@color/grafite">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/carrinhoQtd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Texto.Rotulo"
                    android:textColor="@color/acafrao_brilho" />

                <TextView
                    android:id="@+id/carrinhoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Texto.Subtitulo"
                    android:textColor="@color/branco" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver pedido"
                app:icon="@drawable/ic_carrinho" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
