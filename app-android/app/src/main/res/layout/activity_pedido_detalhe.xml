<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="Pedido" />

    <TextView
        android:id="@+id/avisoOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terracota_claro"
        android:padding="12dp"
        android:text="Sem conexão. Mostrando o QR Code salvo no aparelho."
        android:textAppearance="@style/Texto.Rotulo"
        android:textColor="@color/terracota_escuro"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_pequena">

                <!-- Resumo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/detNumero"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/Texto.Titulo" />

                            <TextView
                                android:id="@+id/detStatus"
                                style="@style/Etiqueta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/detEvento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texto.Corpo" />

                        <TextView
                            android:id="@+id/detInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Texto.Rotulo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- QR Code -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apresente na retirada"
                            android:textAppearance="@style/Texto.Subtitulo" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_qr"
                            android:padding="14dp">

                            <ImageView
                                android:id="@+id/qrImagem"
                                android:layout_width="230dp"
                                android:layout_height="230dp"
                                android:contentDescription="QR Code do pedido" />

                            <TextView
                                android:id="@+id/qrRetirado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_selo"
                                android:backgroundTint="@color/grafite"
                                android:paddingStart="16dp"
                                android:paddingTop="6dp"
                                android:paddingEnd="16dp"
                                android:paddingBottom="6dp"
                                android:text="RETIRADO"
                                android:textAppearance="@style/Texto.Subtitulo"
                                android:textColor="@color/branco"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/qrCodigo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/grafite"
                            android:textIsSelectable="true"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/qrRetirada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textAppearance="@style/Texto.Corpo"
                            android:textColor="@color/oliva" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pagamento -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/acafrao_claro">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagamento"
                            android:textAppearance="@style/Texto.Subtitulo" />

                        <TextView
                            android:id="@+id/pagMetodo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texto.Corpo" />

                        <TextView
                            android:id="@+id/pagPrazo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Texto.Rotulo"
                            android:textColor="@color/terracota_escuro" />

                        <LinearLayout
                            android:id="@+id/blocoPix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_selo"
                            android:backgroundTint="@color/branco"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/pixCodigo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:textColor="@color/grafite"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/botaoCopiar"
                                style="@style/Widget.Abadeus.Botao.Texto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copiar" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textoDinheiro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/Texto.Corpo"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botaoSimular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Simular pagamento aprovado"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botaoConfirmarPagamento"
                            style="@style/Widget.Abadeus.Botao.Oliva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Confirmar pagamento recebido"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botaoNovoPix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Pagar com Pix"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Itens -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Itens"
                            android:textAppearance="@style/Texto.Subtitulo" />

                        <LinearLayout
                            android:id="@+id/listaItens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/areia_escura" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total"
                                android:textAppearance="@style/Texto.Subtitulo" />

                            <TextView
                                android:id="@+id/detTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/Texto.Preco"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/detObservacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/Texto.Rotulo"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Historico de status (auditoria) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Histórico"
                            android:textAppearance="@style/Texto.Subtitulo" />

                        <LinearLayout
                            android:id="@+id/listaHistorico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoReembolsar"
                    style="@style/Widget.Abadeus.Botao.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:text="Reembolsar pedido"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoCancelar"
                    style="@style/Widget.Abadeus.Botao.Contorno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margem_pequena"
                    android:text="Cancelar pedido"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
